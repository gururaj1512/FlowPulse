# ============================================================
# Environment Variables Template for FlowPulse Monorepo
# ============================================================
# Copy this file to .env or frontend/.env.local for local development.
# See README.md for complete details.
# ============================================================

# ── nhost Backend URLs ──
# For local development with `nhost up`:
NEXT_PUBLIC_NHOST_SUBDOMAIN=local
NEXT_PUBLIC_NHOST_REGION=

# For production (fill in after deploying to nhost cloud):
# NEXT_PUBLIC_NHOST_SUBDOMAIN=your-project-subdomain
# NEXT_PUBLIC_NHOST_REGION=us-east-1

# ── Groq API (for LLM calls) ──
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── ntfy.sh Topic (for notifications) ──
NTFY_TOPIC=flowpulse-demo
